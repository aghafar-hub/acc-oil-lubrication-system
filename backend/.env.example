# Copy this file to .env before running anything.

# Dev default: local SQLite file, zero setup required.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example — uncomment and fill in, then change
# the datasource provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/acc_oil_db"

JWT_SECRET="change-this-to-a-long-random-string-before-deploying"
JWT_EXPIRES_IN="8h"
# Mobile sessions are longer-lived to support the offline queue/sync cycle (Section 13.1)
JWT_MOBILE_EXPIRES_IN="30d"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Section 9 / Settings → Notifications — required before go-live, not for building (Section 2.4)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL="no-reply@acc-oil.example.com"
